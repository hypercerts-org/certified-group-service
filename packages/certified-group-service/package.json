{
  "name": "@hypercerts-org/certified-group-service",
  "version": "0.1.0",
  "description": "TypeScript XRPC definitions and types for the Certified Group Service (CGS), for use with @atproto/lex",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypercerts-org/certified-group-service.git",
    "directory": "packages/certified-group-service"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.js",
    "check:generated": "node scripts/generate.js --check",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.json",
    "prepack": "pnpm run build",
    "test": "pnpm run build && tsc --project tsconfig.test.json && node --test \"test/**/*.test.js\"",
    "check:package": "node scripts/check-package.js",
    "check": "pnpm run check:generated && pnpm run typecheck && pnpm run test"
  },
  "peerDependencies": {
    "@atproto/lex": "^0.4.2"
  },
  "devDependencies": {
    "@atproto/lex": "0.4.4",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
