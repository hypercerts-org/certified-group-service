{
  "lexicon": 1,
  "id": "app.certified.group.repo.deleteRecord",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Delete a record from the group's repository. Proxied through the user's PDS.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["repo", "collection", "rkey"],
          "properties": {
            "repo": { "type": "string", "format": "at-identifier" },
            "collection": { "type": "string", "format": "nsid" },
            "rkey": { "type": "string" },
            "swapRecord": {
              "type": "string",
              "format": "cid",
              "description": "Compare and swap with the previous record by CID."
            },
            "swapCommit": {
              "type": "string",
              "format": "cid",
              "description": "Compare and swap with the previous commit by CID."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      },
      "errors": [
        {
          "name": "InvalidSwap",
          "description": "A swapRecord or swapCommit CID did not match the current state, so the write was refused."
        }
      ]
    }
  }
}
